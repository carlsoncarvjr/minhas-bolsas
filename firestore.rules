rules_version = '2';
// Regras do portal de bolsas.
// Sem login: quem tem o link com o código (?c=...) lê e grava. Os dados ficam em lojas/{código}/...
// O código de verdade não fica aqui: o deploy troca __CODIGO__ pelo valor do arquivo .segredos
// (ver README, "Publicar"). Ninguém consegue listar as lojas, então sem o código não há como achar nada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lojas/{codigo}/{col}/{id} {
      allow read, write: if codigo == '__CODIGO__' && col in ['bolsas', 'fotos', 'movimentos', 'clientes'];
    }
  }
}
